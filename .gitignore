# ─────────────────────────────────────────────
#  Root .gitignore
#  Covers: client (Vite + React) & server (Node + Express)
# ─────────────────────────────────────────────


# ── Dependencies ──────────────────────────────
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js


# ── Build output ──────────────────────────────
client/dist/
client/dist-ssr/
client/build/
server/dist/
server/build/


# ── Environment variables ─────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
client/.env
client/.env.*
server/.env
server/.env.*


# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server/logs/


# ── Runtime / process ─────────────────────────
pids/
*.pid
*.seed
*.pid.lock
.node_repl_history


# ── Test & coverage ───────────────────────────
coverage/
client/coverage/
server/coverage/
*.lcov
.nyc_output/


# ── Cache ─────────────────────────────────────
.cache/
.parcel-cache/
client/.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo


# ── Package manager locks (keep one, ignore rest)
# Uncomment whichever you are NOT using:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


# ── OS generated files ────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ── IDE / Editor ──────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.project
.classpath
.settings/


# ── Vite / frontend specific ──────────────────
client/*.local
client/stats.html


# ── Upload / static generated files ──────────
server/uploads/
server/public/uploads/
client/public/generated/


# ── Miscellaneous ─────────────────────────────
*.pem
*.p12
*.key
*.crt
.vercel
.netlify
.turbo
